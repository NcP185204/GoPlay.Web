@model GoPlay.Web.ViewModels.GenerateSlotsViewModel

@{
    ViewData["Title"] = "Sinh khung giờ";
}

<h2 class="mb-4">Sinh khung giờ</h2>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Thông tin sinh slot</div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="GenerateSlots" method="post" asp-antiforgery="true">
                    <div class="mb-3">
                        <label asp-for="CourtId" class="form-label"></label>
                        <select asp-for="CourtId" class="form-select">
                            <option value="">-- Chọn sân --</option>
                            @foreach (var court in Model.Courts)
                            {
                                <option value="@court.Id">@court.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CourtId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NumberOfDays" class="form-label"></label>
                        <input asp-for="NumberOfDays" class="form-control" type="number" min="1" />
                        <span asp-validation-for="NumberOfDays" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label asp-for="OpenTime" class="form-label"></label>
                                <input asp-for="OpenTime" class="form-control" type="time" />
                                <span asp-validation-for="OpenTime" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label asp-for="CloseTime" class="form-label"></label>
                                <input asp-for="CloseTime" class="form-control" type="time" />
                                <span asp-validation-for="CloseTime" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SlotDurationInMinutes" class="form-label"></label>
                        <input asp-for="SlotDurationInMinutes" class="form-control" type="number" min="30" />
                        <span asp-validation-for="SlotDurationInMinutes" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Sinh khung giờ</button>
                </form>
            </div>
        </div>
    </div>
</div>