@model GoPlay.Web.ViewModels.CourtDetailsViewModel

@{
    ViewData["Title"] = Model.Court.Name;
    var availableSlots = Model.TimeSlots.Where(t => t.IsAvailable).ToList();
}

<div class="mb-3">
    <a asp-controller="Courts" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Bố cục 2 cột: ảnh + thông tin sân -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        @if (!string.IsNullOrWhiteSpace(Model.Court.ThumbnailUrl))
        {
            <img src="@Model.Court.ThumbnailUrl" class="img-fluid rounded-4 shadow-sm w-100" alt="@Model.Court.Name" />
        }
        else
        {
            <div class="court-placeholder rounded-4 d-flex align-items-center justify-content-center w-100" style="height:280px;">
                <i class="bi bi-image display-1 text-white-50"></i>
            </div>
        }
    </div>
    <div class="col-lg-6">
        <span class="badge bg-success mb-2">@Model.Court.CourtType</span>
        <h2 class="fw-bold mb-2">@Model.Court.Name</h2>
        <p class="text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@Model.Court.Address</p>
        <p class="mb-3">@Model.Court.Description</p>
        <p class="fs-4 fw-bold text-success">
            @Model.Court.PricePerHour.ToString("N0") VND<span class="text-muted fs-6">/giờ</span>
        </p>
    </div>
</div>

<hr />

<h4 class="fw-bold mb-3">
    <i class="bi bi-calendar3 text-success me-2"></i>Khung giờ ngày @Model.Date.ToString("dd/MM/yyyy")
</h4>

<!-- Chọn ngày để xem slot tương ứng -->
<form asp-controller="Courts" asp-action="Details" asp-route-id="@Model.Court.Id" method="get" class="row g-2 align-items-center mb-4">
    <div class="col-auto">
        <label for="date" class="form-label fw-semibold">Chọn ngày</label>
        <input type="date" id="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-calendar-check me-1"></i>Xem khung giờ
        </button>
    </div>
</form>

@if (Model.TimeSlots.Count == 0)
{
    <div class="alert alert-light border text-center py-4">Ngày này chưa có khung giờ.</div>
}
else
{
    <!-- Form đặt sân: giữ nguyên action + field name để chức năng không hỏng -->
    <form asp-controller="Bookings" asp-action="Create" method="post" asp-antiforgery="true">
        <input type="hidden" name="CourtId" value="@Model.Court.Id" />

        <div class="d-flex flex-wrap gap-2 mb-4" id="slotList">
            @foreach (var slot in Model.TimeSlots.OrderBy(t => t.StartTime))
            {
                if (slot.IsAvailable)
                {
                    <label class="slot-option" data-price="@slot.Price">
                        <input type="checkbox" name="SlotIds" value="@slot.Id" class="slot-checkbox d-none" />
                        <span class="slot-badge">
                            <span class="fw-semibold">@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</span>
                            <small class="d-block text-muted">@slot.Price.ToString("N0") VND</small>
                        </span>
                    </label>
                }
                else
                {
                    <div class="slot-badge slot-disabled" title="Đã đặt">
                        <span class="fw-semibold text-decoration-line-through">@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</span>
                        <small class="d-block">Đã đặt</small>
                    </div>
                }
            }
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body bg-light rounded-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="fs-5">
                            <span class="text-muted me-2">Tổng tiền tạm tính:</span>
                            <strong id="totalPrice" class="text-success">0 VND</strong>
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>Chọn khung giờ để cập nhật tổng tiền
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label for="note" class="form-label fw-semibold">Ghi chú</label>
                <textarea id="note" name="Note" class="form-control" rows="2" placeholder="Ghi chú (không bắt buộc)"></textarea>
            </div>

            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-cash-coin me-2"></i>Đặt sân (thanh toán tiền mặt)
            </button>
        }
        else
        {
            <div class="alert alert-warning">
                Vui lòng <a asp-controller="Account" asp-action="Login">đăng nhập</a> để đặt sân.
            </div>
        }
    </form>
}

@section Scripts {
    <script>
        (function () {
            var checkboxes = document.querySelectorAll('.slot-checkbox');
            var totalEl = document.getElementById('totalPrice');
            if (!totalEl) return;

            function formatNumber(value) {
                return value.toLocaleString('vi-VN');
            }

            function updateTotal() {
                var total = 0;
                checkboxes.forEach(function (box) {
                    if (box.checked) {
                        var label = box.closest('.slot-option');
                        if (label) total += Number(label.getAttribute('data-price'));
                    }
                });
                totalEl.textContent = formatNumber(total) + ' VND';
            }

            checkboxes.forEach(function (box) {
                box.addEventListener('change', function () {
                    var label = box.closest('.slot-option');
                    if (label) label.classList.toggle('selected', box.checked);
                    updateTotal();
                });
            });
        })();
    </script>
}